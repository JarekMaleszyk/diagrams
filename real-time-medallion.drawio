        </mxCell>
        <mxCell id="z9c7UyduO_na5R2LQD3L-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="dimensional&amp;nbsp;&lt;br&gt;&lt;span class=&quot;HwtZe&quot; lang=&quot;en&quot;&gt;&lt;span class=&quot;jCAhz ChMk0b&quot;&gt;&lt;span class=&quot;ryNqvb&quot;&gt;enriched&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;business ready&amp;nbsp;" vertex="1">
